{
  "name": "governance-playground",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write '**/*.{ts,json,md}'",
    "format:check": "prettier --check '**/*.{ts,json,md}'",
    "seed": "tsx src/seed.ts",
    "mcp": "tsx src/mcp-server.ts",
    "play": "tsx src/play.ts",
    "feed": "tsx src/feed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.23.1",
    "runwarden": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ai": "7.0.123",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
