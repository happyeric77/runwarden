{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "compilerOptions": {
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/db/test-postgres.ts"
  ],
  "extends": "./tsconfig.json",
  "include": ["src/**/*"]
}
