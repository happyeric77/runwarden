{
  "name": "runwarden-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-ia32",
      "@embedded-postgres/linux-ppc64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64"
    ]
  },
  "scripts": {
    "build": "pnpm --filter runwarden build",
    "format": "pnpm --filter runwarden format",
    "format:check": "pnpm --filter runwarden format:check",
    "test": "pnpm --filter runwarden test",
    "test:integration": "pnpm --filter runwarden test:integration",
    "typecheck": "pnpm --filter runwarden typecheck"
  }
}
