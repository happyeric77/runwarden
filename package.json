{
  "author": "Eric Lee",
  "bin": {
    "runwarden": "./dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/happyeric77/runwarden/issues"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.60",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/pg": "^8.15.5",
    "ai": "7.0.123",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "description": "A lightweight, self-hosted TypeScript agent runtime: durable invocations on your own Postgres, with enforced tool-call policy, governance, and audit.",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "3.6.2",
    "tsdown": "^0.23.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "dist",
    "migrations"
  ],
  "homepage": "https://github.com/happyeric77/runwarden#readme",
  "keywords": [
    "agent",
    "ai",
    "audit",
    "durable",
    "mcp",
    "policy",
    "postgres",
    "runtime",
    "typescript"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "runwarden",
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-ia32",
      "@embedded-postgres/linux-ppc64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64"
    ]
  },
  "prettier": {
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^[./]"
    ],
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyeric77/runwarden.git"
  },
  "scripts": {
    "build": "tsdown",
    "demo": "tsx examples/governed-invocation.ts",
    "format": "prettier --write '**/*.{ts,json,md}'",
    "format:check": "prettier --check '**/*.{ts,json,md}'",
    "prepack": "npm run build",
    "quickstart": "tsx examples/quickstart/main.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0"
}
